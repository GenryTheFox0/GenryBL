        genry_music_aliases = {
            "lightness radio edit": "lightness_radio_bus",
            "lightness radio": "lightness_radio_bus",
            "lightness_radio": "lightness_radio_bus",
            "lightness-radio": "lightness_radio_bus",
            "lightness_radio_edit": "lightness_radio_bus",
            "lightness-radio-edit": "lightness_radio_bus",
            "radio_lightness": "lightness_radio_bus",
            "lightness": "lightness",
        }
        genry_music_builtin_paths = {
            "lightness_radio_bus": "sound/music/lightness_radio.ogg",
            "lightness": "sound/music/lightness.ogg",
        }
        key = str(name).strip()
        alias_key = key.lower().replace("_", " ").replace("-", " ")
        key = genry_music_aliases.get(alias_key, genry_music_aliases.get(key.lower(), key))
        try:
            return music_list.get(key, genry_music_builtin_paths.get(key, None))
